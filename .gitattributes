# Let Git normalise line endings for text files
* text=auto

# Unity YAML files: keep LF so Windows/Mac don't fight over line endings
*.unity      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf

# C# scripts
*.cs diff=csharp

# Binary files: never touch them
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.tif  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
